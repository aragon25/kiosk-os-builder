#!/bin/sh

# rootfs, bootfs, sqfs-image and rootmnt are mounted yet at this point.

SCRIPT_PATH="$(realpath "$0")"
SCRIPT_NAME="$(basename "$SCRIPT_PATH")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"

[ -e "${SCRIPT_DIR}/functions" ] && . "${SCRIPT_DIR}/functions" || exit 1

prepare_system() {
  # configuring fstab in rootmnt
  local fstab_boot=$(cat ${SQFS_MOUNT}/SYSTEM/etc/fstab 2>/dev/null)
  [ -z "$ROOT_FSTYPE" ] && ROOT_FSTYPE=$(blkid -o value -s TYPE "${ROOT_DEV}" 2>/dev/null)
  [ -z "$ROOT_FSTYPE" ] && ROOT_FSTYPE="auto"
  [ -z "${fstab_boot##*\/boot\/firmware*}" ] && boot_dir="/boot/firmware" || boot_dir="/boot"
  echo "proc                       /proc           proc    defaults                      0       0" > ${rootmnt}/etc/fstab
  echo "${BOOT_DEV}                ${boot_dir}     vfat    defaults                      0       0" >> ${rootmnt}/etc/fstab
  
  # add bind mounts for config and persist_storage
  rm -rf "${rootmnt}/var/imgldr"
  rm -rf "${rootmnt}/var/sqfs"
  mkdir -p "${rootmnt}/var/imgldr/config"
  mkdir -p "${rootmnt}/var/imgldr/images"
  mkdir -p "${rootmnt}/var/sqfs/config"
  mkdir -p "${rootmnt}/var/sqfs/storage"
  mount -o bind "${ROOT_MOUNT}/CONFIG" "${rootmnt}/var/imgldr/config"
  mount -o bind "${ROOT_MOUNT}/IMAGES" "${rootmnt}/var/imgldr/images"
  ln -s "/usr/lib/imgldr" "${rootmnt}/var/imgldr/initramfs"
  mount -o bind "${CONFIG_DIR}" "${rootmnt}/var/sqfs/config"
  mount -o bind "${STORAGE_DIR}" "${rootmnt}/var/sqfs/storage"
  ln -s "/usr/lib/imgldr" "${rootmnt}/var/sqfs/initramfs"

  # end here for developer mode
  [ "$IMAGE_MODE" = "DEVELOPER" ] && return 0
  
  # create user links for persist_storage in rootmnt
  if [ -f "${rootmnt}/etc/pam.d/common-session" ] && ! grep -q "/usr/local/bin/create-user-link" "${rootmnt}/etc/pam.d/common-session"; then
    echo "session optional pam_exec.so /usr/local/bin/create-user-link" >> "${rootmnt}/etc/pam.d/common-session"
  fi

  # hwclock_fix
  if [ ! -f "${STORAGE_DIR}/autosave/fake-hwclock" ]; then
    if [ -f "${rootmnt}/etc/date/fake-hwclock" ]; then 
      cp -f "${rootmnt}/etc/date/fake-hwclock" "${STORAGE_DIR}/autosave/fake-hwclock"
    else
      echo "2025-06-01 15:20:00" > "${STORAGE_DIR}/autosave/fake-hwclock"
    fi
  fi
  if [ ! -f "${STORAGE_DIR}/autosave/clock" ]; then
    if [ -f "${rootmnt}/etc/date/clock" ]; then 
      cp -f "${rootmnt}/etc/date/clock" "${STORAGE_DIR}/autosave/clock"
    else
      echo "1748784000" > "${STORAGE_DIR}/autosave/clock" #date -d "2025-06-01 15:20:00" +%s
    fi
  fi
  if [ -f "${rootmnt}/etc/fake-hwclock.data" ]; then
    rm -f "${rootmnt}/etc/fake-hwclock.data"
    ln -s "/var/sqfs/storage/autosave/fake-hwclock" "${rootmnt}/etc/fake-hwclock.data"
  fi
  if [ -f "${rootmnt}/var/lib/systemd/clock" ]; then
    rm -f "${rootmnt}/var/lib/systemd/clock"
    ln -s "/var/sqfs/storage/autosave/clock" "${rootmnt}/var/lib/systemd/clock"
  fi

  # auto-reboot_fix
  if [ ! -f "${STORAGE_DIR}/autosave/auto-reboot_boot.state" ]; then 
    if [ -f "${rootmnt}/var/lib/auto-reboot/boot.state" ] && [ ! -L "${rootmnt}/var/lib/auto-reboot/boot.state" ]; then 
      mv -f "${rootmnt}/var/lib/auto-reboot/boot.state" "${STORAGE_DIR}/autosave/auto-reboot_boot.state"
    else
      echo "shutdown" > "${STORAGE_DIR}/autosave/auto-reboot_boot.state"
    fi
  fi
  if [ ! -L "${rootmnt}/var/lib/auto-reboot/boot.state" ]; then
    mkdir -p "${rootmnt}/var/lib/auto-reboot"
    ln -s "/var/sqfs/storage/autosave/auto-reboot_boot.state" "${rootmnt}/var/lib/auto-reboot/boot.state"
  fi
  local auto_reboot="$(cat "${STORAGE_DIR}/autosave/auto-reboot_boot.state" 2>/dev/null)"
  if [ "${auto_reboot}" = "bootup" ]; then
    echo "shutdown" > "${STORAGE_DIR}/autosave/auto-reboot_boot.state"
    imgldr_do_reboot 3 "Auto-reboot: Rebooting after unrecognized shutdown..."
  fi

  # activate initramfs-splash plymouth theme if configured or restore previous theme
  current_theme=$(sed -n 's/^[[:space:]]*Theme[[:space:]]*=[[:space:]]*//p' "${rootmnt}/etc/plymouth/plymouthd.conf" 2>/dev/null | head -n1)
  if [ "$current_theme" != "initramfs-splash" ] && [ "$current_theme" != "" ]; then
    echo "$current_theme" > "${STORAGE_DIR}/autosave/plymouth_savedtheme"
  fi
  saved_theme="$(awk 'NR==1 {print $1}' ${STORAGE_DIR}/plymouth_savedtheme 2>/dev/null)"
  if [ "$saved_theme" != "" ]; then
    echo "[Daemon]" > "${rootmnt}/etc/plymouth/plymouthd.conf"
    if [ "$saved_theme" != "" ] && [ -d "${rootmnt}/usr/share/plymouth/themes/$saved_theme" ]; then
      echo "Theme=${saved_theme}" >> ${rootmnt}/etc/plymouth/plymouthd.conf
    elif [ -d "${rootmnt}/usr/share/plymouth/themes/ceratopsian" ]; then
      echo "Theme=ceratopsian" >> ${rootmnt}/etc/plymouth/plymouthd.conf
    else
      echo "Theme=details" >> ${rootmnt}/etc/plymouth/plymouthd.conf
    fi
  fi
  if [ -f "${rootmnt}/usr/share/plymouth/themes/initramfs-splash/plymouth_forced" ]; then
    echo "[Daemon]" > "${rootmnt}/etc/plymouth/plymouthd.conf"
    echo "Theme=initramfs-splash" >> ${rootmnt}/etc/plymouth/plymouthd.conf
  fi
}

umount_boot() {
  local attempt
  sync >/dev/null 2>&1
  attempt=1
  [ "$(mount | fgrep "${BOOT_MOUNT}" | wc -l)" = "0" ] && BOOT_MOUNT="false"
  while [ "${BOOT_MOUNT}" != "false" ] && [ $attempt -le 30 ]; do
    umount "${BOOT_MOUNT}" >/dev/null 2>&1 && BOOT_MOUNT="false" || { sleep 1; attempt=$((attempt + 1)); }
  done
  [ "${BOOT_MOUNT}" != "false" ] && echo "Could not umount: ${BOOT_MOUNT}"
}

change_init() {
  local init_script="/usr/lib/imgldr/init"
  mkdir -p /conf
  touch /conf/imgldr.conf
  if [ "${FIRSTBOOT}" = "yes" ] && [ -f "${rootmnt}${init_script}" ]; then
    echo "INIT=$init_script" >> "/conf/imgldr.conf"
  elif [ "${FIRSTBOOT}" = "yes" ]; then
    imgldr_pretty_text "       !!! WARNING !!!" "    First boot init script" "          not found!" "   Running default init..."
  fi
}

prepare_system
umount_boot
#change_init

exit 0
